# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dataextraction
POSTGRES_USER=dex_user
POSTGRES_PASSWORD=<required — use strong password, min 20 chars>
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=dataextraction
TEMPORAL_TASK_QUEUE_PREFIX=dataextraction
# Production TLS (required when not on localhost):
# TEMPORAL_TLS_CERT_PATH=/certs/temporal-client.crt
# TEMPORAL_TLS_KEY_PATH=/certs/temporal-client.key
# TEMPORAL_TLS_CA_PATH=/certs/ca.crt

# ── Temporal Worker Concurrency ───────────────────────────────────────────────
FEDERAL_WORKER_MAX_CONCURRENT_ACTIVITIES=3
GMAPS_WORKER_MAX_CONCURRENT_ACTIVITIES=5
OSM_WORKER_MAX_CONCURRENT_ACTIVITIES=4
PIPELINE_WORKER_MAX_CONCURRENT_ACTIVITIES=8
STORAGE_WORKER_MAX_CONCURRENT_ACTIVITIES=10

# ── Authentication ────────────────────────────────────────────────────────────
# Keep true in production; set to false only in local development when login UI is disabled.
AUTH_REQUIRED=true
JWT_SECRET_KEY=<required — min 64 random characters, never commit this>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
API_ADMIN_EMAIL=admin@dataextraction.io
API_ADMIN_PASSWORD=<required — complex password, min 16 chars>

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000
DEBUG=false
ENVIRONMENT=development

# ── Agent Configuration ───────────────────────────────────────────────────────
AGENT_DLQ_AUTO_REPLAY_THRESHOLD=100
AGENT_DB_POOL_THROTTLE_THRESHOLD=0.85
AGENT_REQUIRE_HUMAN_APPROVAL=true
AGENT_CYCLE_INTERVAL_SECONDS=300
AGENT_APPROVAL_TIMEOUT_HOURS=24

# ── US Federal & Open Data API Keys ──────────────────────────────────────────
CENSUS_DATA_API_KEY=
DATA_GOV_API_KEY=
BLS_API_KEY=
OPENFDA_API_KEY=
BEA_DATA_API_KEY=
EIA_API_KEY=
USGS_WATER_API_KEY=
SAM_GOV_API_KEY=

# ── Google Maps Platform (optional — enrichment only) ─────────────────────────
# Primary discovery uses gmaps-scraper (local, zero cost)
# GMP API is ONLY for enriching leads missing phone/website
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENRICHMENT_ENABLED=false
GOOGLE_MAPS_DAILY_BUDGET_USD=50.0
GOOGLE_MAPS_CACHE_TTL_DAYS=30
GOOGLE_MAPS_FIELD_MASK=places.displayName,places.formattedAddress,places.nationalPhoneNumber,places.websiteUri

# ── AI / Gemini (optional — for enhanced agent decisions) ─────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1

# ── AWS Secrets Manager (production alternative to .env) ──────────────────────
# Set USE_AWS_SECRETS=true to load secrets from AWS instead of .env
USE_AWS_SECRETS=false
AWS_REGION=us-east-1
AWS_SECRET_NAME=dataextraction/production

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Email Alerts (optional) ───────────────────────────────────────────────────
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=

# ── Scraper Rate Limits & Agent 1 Federal Registry Settings ───────────────────
# These override defaults in config/rate_limits.yaml and config/agents.yaml
# SEC_EDGAR_REQUESTS_PER_SECOND=10
# SAM_GOV_REQUESTS_PER_SECOND=1
# CMS_NPI_LIMIT_PER_RUN=50000
# FEDERAL_REGISTRY_SOURCES=sec_edgar,fdic,usaspending,propublica,cms_npi,sam_gov
# FEDERAL_SCRAPER_TIMEOUT_SECONDS=7200
# FEDERAL_SCRAPER_HEARTBEAT_SECONDS=10
# FEDERAL_SCRAPER_ERROR_THRESHOLD_PCT=25.0
# FEDERAL_SEC_DEFAULT_MODE=tickers
# FEDERAL_FDIC_SOURCE=both

# ── Lakehouse & Object Storage (MinIO / AWS S3) ──────────────────────────────
LAKEHOUSE_ENDPOINT_URL=http://localhost:9000
LAKEHOUSE_BUCKET_NAME=dataextraction-lakehouse
LAKEHOUSE_ACCESS_KEY=minioadmin
LAKEHOUSE_SECRET_KEY=miniopassword
LAKEHOUSE_REGION=us-east-1
LAKEHOUSE_USE_SSL=false

# ── Email Enrichment & SMTP Verification (Agent 7) ─────────────────────────
EMAIL_ENRICHMENT_WORKER_MAX_CONCURRENT_ACTIVITIES=10
EMAIL_ENRICHMENT_RATE_PER_SECOND=50.0
EMAIL_ENRICHMENT_PER_HOST_LIMIT=2
EMAIL_ENRICHMENT_TOTAL_TIMEOUT=10.0
EMAIL_ENRICHMENT_MAX_BODY_SIZE=5242880
SMTP_PROBE_TIMEOUT=5.0
SMTP_PROBE_EHLO_DOMAIN=dataextraction.internal

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=DataExtraction

# ── Ollama Local LLM & AI Agents (Llama 3.1 8B) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=5.0
OLLAMA_BATCH_TIMEOUT_SECONDS=30.0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CIRCUIT_BREAKER_THRESHOLD=3
OLLAMA_CIRCUIT_BREAKER_RECOVERY_SECONDS=60.0
OLLAMA_ENABLED=true
LLM_ENTITY_ADJUDICATION_ENABLED=true
LLM_ENTITY_ADJUDICATION_TIMEOUT=5.0
LLM_NORMALIZATION_ENABLED=true
LLM_NORMALIZATION_TIMEOUT=5.0
LLM_BATCH_CONCURRENCY=5

